rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Operational state contains customers, sales, stock, expenses and users.
    // It must never be readable anonymously.
    match /private_state/{document} {
      allow read, write: if request.auth != null;
    }

    // Legacy document is locked down as well. Kept only so an old deployed
    // client cannot expose or mutate it after the rules are deployed.
    match /public_state/{document} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
